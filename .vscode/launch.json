{
    "version": "2.0.0",
    "configurations": [
        {
            "name": "C++: Debug with GDB (GNOME Terminal)",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/app",
            "args": [],

            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",

            "environment": [],
            "externalConsole": true,

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",

            "preLaunchTask": "Build C++ Project",

            "setupCommands": [
                {
                    "description": "Enable Pretty Printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Intel Assembly Syntax",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}