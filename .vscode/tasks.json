{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build C++ Project",
            "command": "g++ -std=c++17 -g -O0 -Wall -Wextra -I\"${workspaceFolder}/include\" \"${workspaceFolder}\"/src/*.cpp -o \"${workspaceFolder}/app\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}